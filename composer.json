{
	"name": "valtopina/laravel-odbc",
	"description": "ODBC integration for Laravel framework ",
	"type": "library",
	"homepage": "https://github.com/valtopina/laravel-odbc",
	"require": {
		"php": "^5.3.3 || >=7.0",
		"illuminate/database": "~5.1 || >= 6.0",
		"illuminate/support": "~5.1 || >= 6.0"
	},
	"autoload": {
		"classmap": [
			"src"
		]
	},
	"extra": {
		"laravel": {
			"providers": [
				"Abram\\Odbc\\ODBCServiceProvider"
			]
		}
	}
}
